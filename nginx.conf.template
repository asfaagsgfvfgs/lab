server {
  listen 8192;
  server_name _;

  client_max_body_size 1024m;

  # Simple health endpoint for Cerebrium checks
  location = /health {
    add_header Content-Type text/plain;
    return 200 "OK";
  }

  # If requests arrive WITH the Cerebrium prefix, strip it before sending to Jupyter
  # PREFIX example: /v4/p-eb8da2d3/min
  location ^~ ${PREFIX}/ {
    rewrite ^${PREFIX}/(.*)$ /$1 break;
    proxy_pass http://127.0.0.1:8888;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # websockets (kernels/terminals)
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    # Disable upstream compression so sub_filter can rewrite HTML/JS/CSS reliably
    proxy_set_header Accept-Encoding "";

    # Fix redirects that come back as "/lab", "/login", etc.
    proxy_redirect ~^(/.*)$ ${PREFIX}$1;

    # Rewrite absolute asset paths so the browser keeps the Cerebrium prefix
    sub_filter_once off;
    sub_filter_types text/html text/css application/javascript;
    sub_filter 'href="/'   'href="${PREFIX}/';
    sub_filter 'src="/'    'src="${PREFIX}/';
    sub_filter 'action="/' 'action="${PREFIX}/';
    sub_filter 'url(/'     'url(${PREFIX}/';
  }

  # If Cerebrium already stripped the prefix, just pass-through
  location / {
    proxy_pass http://127.0.0.1:8888;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    proxy_set_header Accept-Encoding "";

    # Still rewrite redirects + absolute paths so the browser uses the Cerebrium prefix
    proxy_redirect ~^(/.*)$ ${PREFIX}$1;

    sub_filter_once off;
    sub_filter_types text/html text/css application/javascript;
    sub_filter 'href="/'   'href="${PREFIX}/';
    sub_filter 'src="/'    'src="${PREFIX}/';
    sub_filter 'action="/' 'action="${PREFIX}/';
    sub_filter 'url(/'     'url(${PREFIX}/';
  }
}
